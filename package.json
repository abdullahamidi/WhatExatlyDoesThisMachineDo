{
  "name": "what-exactly-does-this-machine-do",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/perf/bundle-budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:dev": "vite build && electron desktop",
    "build:steam": "npm run typecheck && node scripts/desktop/package.mjs --mode production",
    "build:steam-demo": "npm run typecheck && node scripts/desktop/package.mjs --mode demo",
    "icon:desktop": "python -I scripts/desktop/make_icon.py",
    "perf:bundle": "node scripts/perf/bundle-budget.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "44.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  }
}
